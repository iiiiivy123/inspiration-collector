# Public source allowlist. Tests, personal data and build outputs stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/DISCLAIMER.md
!/docs/
/docs/*
!/docs/usage.md
!/docs/third-party-media.md
!/source/
/source/*
!/source/extension/
/source/extension/*
!/source/extension/*.js
!/source/extension/*.html
!/source/extension/*.css
!/source/extension/*.json
!/source/extension/icon-*.png
/source/extension/live-test.*
!/source/server/
/source/server/*
!/source/server/*.py
!/source/server/*.txt
!/source/server/*.ps1
!/tools/
/tools/*
!/tools/build_release.py
!/tools/build_windows.py
!/tools/build_media.sh
!/installer/
/installer/*
!/installer/*.cs
!/installer/*.iss
**/__pycache__/
**/*.sqlite*
**/.env*
**/*.log
